POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=pm_app

# IP do host onde as portas dos containers (db/backend/frontend) são publicadas. Padrão
# 127.0.0.1 = só acessível no próprio servidor (o Nginx Proxy Manager alcança os containers
# pela rede Docker `proxy`, não por porta publicada). Só mude para 0.0.0.0 se precisar
# acessar os serviços de fora do host E tiver um firewall na frente.
HOST_BIND_IP=127.0.0.1

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# development (padrão) usa cookies sem a flag Secure, para funcionar em http://localhost.
# Em produção (servido via HTTPS), defina NODE_ENV=production para os cookies de sessão
# ganharem a flag Secure.
NODE_ENV=development

# Em produção, aponte para o domínio público real (ex.: https://seuapp.com.br) — em ambos.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# VITE_API_BASE_URL é usada em BUILD TIME do frontend (vira parte do bundle estático) — mudar
# esse valor exige `docker compose build frontend` de novo, reiniciar o container não basta.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Cloudflare Turnstile (verificação anti-robô em login e cadastro). Opcional: deixe as duas
# vazias para desligar. A site key também é BUILD TIME do frontend (rebuild ao trocar); a
# secret key é lida em runtime pelo backend.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Chave AES-256 (base64, 32 bytes) usada para criptografar a senha do SMTP salva pelo admin.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
