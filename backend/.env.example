DATABASE_URL=postgresql://app_user:app_password@localhost:5432/pm_app
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
PORT=3000
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
# Chave AES-256 (base64, 32 bytes) usada para criptografar a senha do SMTP salva pelo admin.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
# Origem pública do frontend, usada para montar o link de confirmação de e-mail.
FRONTEND_URL=http://localhost:5173
