generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  ADMIN
  SENIOR
  MEMBER
  VIEWER
}

enum StatusCategory {
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELLED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CREATED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  LABEL_ADDED
  LABEL_REMOVED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  COMMENT
  RECURRENCE_GENERATED
}

/// Unidade de intervalo de uma tarefa recorrente (ver `WorkItem.recurrenceUnit`). "A cada N dias"
/// (recorrência personalizada) é só `DAY` com `recurrenceInterval` maior que 1 — não existe uma
/// unidade "CUSTOM" separada, o formulário do frontend que decide como apresentar cada combinação.
enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
}

enum NotificationType {
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_ASSIGNED
  TASK_REMINDER
  TASK_COMPLETED
  TASK_CANCELLED
  PROJECT_MEMBER_ADDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  globalRole   GlobalRole @default(MEMBER) @map("global_role")
  isActive     Boolean    @default(true) @map("is_active")
  /// Fuso horário IANA (ex.: "America/Sao_Paulo") usado para formatar timestamps na UI — datas
  /// "puras" como `WorkItem.dueDate`/`startDate` nunca passam por essa conversão (ver
  /// `frontend/src/lib/dateFormat.ts`), só timestamps reais (atividade, "atualizado em" etc.).
  /// Editável em `/settings/profile`; tudo continua gravado em UTC no banco, isso é só exibição.
  timezone     String     @default("America/Sao_Paulo")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  emailVerifiedAt            DateTime? @map("email_verified_at")
  verificationTokenHash      String?   @map("verification_token_hash")
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at")
  verificationEmailSentAt    DateTime? @map("verification_email_sent_at")

  /// Segredo TOTP criptografado (AES-256-GCM, ver `crypto.util.ts`) — presente antes mesmo de
  /// `twoFactorEnabled` virar true (gravado no /auth/2fa/setup, só confirmado no /enable).
  twoFactorSecret        String?  @map("two_factor_secret")
  twoFactorEnabled       Boolean  @default(false) @map("two_factor_enabled")
  /// Hashes (SHA-256) dos códigos de recuperação ainda não usados; cada um é removido da lista
  /// ao ser consumido (uso único).
  twoFactorRecoveryCodes String[] @default([]) @map("two_factor_recovery_codes")

  refreshTokens   RefreshToken[]
  ownedProjects   Project[]        @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  createdItems    WorkItem[]       @relation("WorkItemCreatedBy")
  statusLockedItems WorkItem[]     @relation("WorkItemStatusLockedBy")
  assignedItems   ItemAssignee[]
  createdDocs     Document[]       @relation("DocumentCreatedBy")
  updatedDocs     Document[]       @relation("DocumentUpdatedBy")
  itemActivities  ItemActivity[]
  notes           Note[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Project {
  id          String    @id @default(uuid())
  name        String
  key         String?   @unique
  icon        String?
  coverColor  String?   @map("cover_color")
  isPublic    Boolean   @default(false) @map("is_public")
  description String?
  ownerId     String    @map("owner_id")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner    User             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members  ProjectMember[]
  statuses Status[]
  items    WorkItem[]
  labels   Label[]
  documents Document[]
  modules   Module[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Status {
  id        String         @id @default(uuid())
  projectId String         @map("project_id")
  name      String
  category  StatusCategory
  position  Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   WorkItem[]

  @@unique([projectId, position])
  @@map("statuses")
}

/// Agrupamento opcional de itens dentro de um projeto (ex.: "Sprint 1", "Backend"). Reaproveita as
/// mesmas colunas de status do projeto — um módulo não tem kanban próprio, é só um recorte dos
/// itens do projeto (`WorkItem.moduleId`). Ver `ModulesService`.
model Module {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   WorkItem[]

  @@unique([projectId, name])
  @@map("modules")
}

model WorkItem {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  description String?
  statusId    String    @map("status_id")
  priority    Priority  @default(NONE)
  parentId    String?   @map("parent_id")
  /// Módulo ao qual o item pertence, opcional — um item pode existir sem módulo (visão geral do
  /// projeto continua mostrando todos os itens, com ou sem módulo).
  moduleId    String?   @map("module_id")
  startDate   DateTime? @map("start_date")
  dueDate     DateTime? @map("due_date")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// Preenchido com quem moveu o item para um status de categoria STARTED ("Em andamento"); limpo
  /// quando o item sai dessa categoria (concluído, cancelado ou volta pra trás). Enquanto
  /// preenchido, só essa pessoa (ou um Admin) pode mudar o status do item — ver
  /// `WorkItemsService.updateStatus`.
  statusLockedById String? @map("status_locked_by_id")

  /// Timestamp de quando o item entrou na categoria STARTED pela vez atual; limpo (`null`) quando
  /// sai dela. Junto com `inProgressSeconds`, permite medir quanto tempo o item de fato ficou "em
  /// andamento" mesmo que ele saia e volte pra essa categoria mais de uma vez — ver
  /// `WorkItemsService.updateStatus`.
  inProgressSince DateTime? @map("in_progress_since")
  /// Soma acumulada (em segundos) de todo o tempo que o item já passou em categoria STARTED,
  /// consolidada cada vez que ele sai dessa categoria. Quando o item chega em COMPLETED, esse
  /// valor final é o tempo real "em andamento" da tarefa — a base do cálculo de métricas por item
  /// e do tempo de execução do projeto (`MetricsService`).
  inProgressSeconds Int @default(0) @map("in_progress_seconds")

  /// Presença de `recurrenceUnit` é o que marca o item como recorrente; `null` = não recorrente.
  /// Quando o item é movido para um status de categoria COMPLETED, `WorkItemsService.updateStatus`
  /// cria automaticamente a próxima ocorrência (mesmo título/descrição/prioridade/etiquetas/módulo
  /// e a própria recorrência, para a série continuar; responsáveis não são copiados de propósito —
  /// a próxima ocorrência começa sem dono definido) com `startDate`/`dueDate` avançados por
  /// `recurrenceInterval` unidades de `recurrenceUnit` a partir das datas do item concluído (ou a
  /// partir de agora, em `dueDate`, se o item não tinha nenhuma data).
  recurrenceUnit     RecurrenceUnit? @map("recurrence_unit")
  recurrenceInterval Int?            @map("recurrence_interval")
  /// Quantas vezes a série já se repetiu até chegar neste item: 0 no item original (nunca
  /// repetiu), N na N-ésima ocorrência gerada — `generateNextOccurrence` propaga
  /// `completedItem.recurrenceCount + 1` para a próxima. Como cada ocorrência já nasce fora de
  /// COMPLETED/CANCELLED e a anterior fica travada nessa categoria (ver trava de item
  /// concluído/cancelado), a query de `MetricsService` para "tarefas recorrentes ativas" filtra só
  /// por `recurrenceUnit != null AND status.category NOT IN (COMPLETED, CANCELLED)` — nunca há mais
  /// de um item "ativo" por série ao mesmo tempo, então não precisa de uma FK própria ligando toda
  /// a cadeia para saber quantas vezes ela já repetiu.
  recurrenceCount Int @default(0) @map("recurrence_count")

  /// Preenchido pelo `DueDateCheckService` na primeira vez que os responsáveis são notificados de
  /// que faltam ~24h para o prazo (TASK_DUE_SOON) — garante disparo único mesmo com o cron rodando
  /// de hora em hora. Zerado sempre que `dueDate` muda via `WorkItemsService.update`, senão um
  /// prazo adiado depois de já notificado nunca dispararia de novo.
  dueSoonNotifiedAt DateTime? @map("due_soon_notified_at")
  /// Mesma lógica de `dueSoonNotifiedAt`, para o alerta TASK_OVERDUE (prazo já vencido, item ainda
  /// não concluído/cancelado).
  overdueNotifiedAt DateTime? @map("overdue_notified_at")

  /// Lembrete customizado (independente dos alertas automáticos acima), em instante absoluto —
  /// quando `reminderOffsetMinutes` está preenchido, este valor é recalculado a partir de `dueDate`
  /// sempre que o prazo muda (ver `WorkItemsService.resolveReminder`); quando `null`, não é um
  /// lembrete relativo e o valor foi digitado diretamente. `null` em ambos = sem lembrete.
  reminderAt DateTime? @map("reminder_at")
  /// Presença = lembrete relativo ("avisar N minutos antes do vencimento"); ausência com
  /// `reminderAt` preenchido = lembrete em data/hora absoluta.
  reminderOffsetMinutes Int? @map("reminder_offset_minutes")
  /// Preenchido pelo `DueDateCheckService` ao disparar o lembrete (TASK_REMINDER) — garante disparo
  /// único; zerado sempre que `reminderAt` muda via `WorkItemsService.update`.
  reminderNotifiedAt DateTime? @map("reminder_notified_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        Status         @relation(fields: [statusId], references: [id], onDelete: Restrict)
  module        Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("WorkItemCreatedBy", fields: [createdById], references: [id])
  statusLockedBy User?         @relation("WorkItemStatusLockedBy", fields: [statusLockedById], references: [id], onDelete: SetNull)
  parent        WorkItem?      @relation("SubItems", fields: [parentId], references: [id], onDelete: SetNull)
  subItems      WorkItem[]     @relation("SubItems")
  assignees     ItemAssignee[]
  labels        ItemLabel[]
  activities    ItemActivity[]

  @@index([projectId])
  @@index([statusId])
  @@index([parentId])
  @@index([moduleId])
  @@index([dueDate])
  @@map("work_items")
}

model ItemAssignee {
  id         String @id @default(uuid())
  workItemId String @map("work_item_id")
  userId     String @map("user_id")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workItemId, userId])
  @@map("item_assignees")
}

model Label {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at")

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   ItemLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model ItemLabel {
  id         String @id @default(uuid())
  workItemId String @map("work_item_id")
  labelId    String @map("label_id")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  label    Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([workItemId, labelId])
  @@map("item_labels")
}

model ItemActivity {
  id         String       @id @default(uuid())
  workItemId String       @map("work_item_id")
  userId     String       @map("user_id")
  type       ActivityType
  message    String?
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workItemId])
  @@map("item_activities")
}

model AllowedDomain {
  id        String   @id @default(uuid())
  domain    String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("allowed_domains")
}

model SmtpSettings {
  id                String   @id @default("singleton")
  host              String
  port              Int
  useSsl            Boolean  @default(false) @map("use_ssl")
  fromEmail         String   @map("from_email")
  authUser          String   @map("auth_user")
  authPassEncrypted String   @map("auth_pass_encrypted")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("smtp_settings")
}

/// Configuração única (singleton) do bot do Telegram usado para enviar notificações — mesmo
/// padrão de `SmtpSettings`: token configurado em tempo de execução via tela de admin
/// (`/settings/telegram`), não variável de ambiente, para poder ser trocado sem redeploy.
model TelegramSettings {
  id                String   @id @default("singleton")
  botTokenEncrypted String   @map("bot_token_encrypted")
  /// Username do bot (ex.: "@projetoio_bot"), só para exibição na tela de admin — não é usado nas
  /// chamadas à Bot API (que só precisam do token).
  botUsername       String?  @map("bot_username")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("telegram_settings")
}

/// Configuração única (singleton) da aplicação Pushover usada para enviar notificações — mesmo
/// padrão de `TelegramSettings`: API token configurado em tempo de execução via tela de admin
/// (`/settings/pushover`), não variável de ambiente, para poder ser trocado sem redeploy.
model PushoverSettings {
  id               String   @id @default("singleton")
  apiTokenEncrypted String  @map("api_token_encrypted")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("pushover_settings")
}

/// Dados do controlador/encarregado (LGPD) usados para montar a página pública de Política de
/// Privacidade. Deliberadamente não hardcoda nenhuma empresa específica: este software é
/// reutilizável por qualquer organização que suba os próprios containers, então essa
/// informação é configurável por quem opera a instância, não fixa no código.
model PrivacySettings {
  id                 String   @id @default("singleton")
  controllerName     String?  @map("controller_name")
  controllerDocument String?  @map("controller_document")
  dpoName            String?  @map("dpo_name")
  dpoEmail           String?  @map("dpo_email")
  retentionNotice    String?  @map("retention_notice")
  additionalNotes    String?  @map("additional_notes")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("privacy_settings")
}

model Document {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  title         String
  content       String   @default("")
  createdById   String   @map("created_by_id")
  updatedById   String?  @map("updated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])

  @@index([projectId])
  @@map("documents")
}

/// Nota/sticker de texto livre, não vinculada a nenhum projeto — visível a qualquer usuário
/// autenticado (mural compartilhado da página inicial). Só quem criou (ou um Admin) pode
/// editar/apagar; ver `NotesService`.
model Note {
  id          String   @id @default(uuid())
  content     String
  color       String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("notes")
}

/// Notificação individual exibida no sino do topo (histórico + não lidas). Sempre criada
/// independente de quais canais externos o usuário tem habilitados — `NotificationsService`
/// dispara e-mail/Telegram/webhook em paralelo, respeitando `NotificationPreference`, mas o
/// registro aqui não depende de nenhum canal ter tido sucesso.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String?
  /// Caminho relativo (ex.: "/projects/<id>/board?item=<id>") para navegação ao clicar — nunca
  /// URL absoluta, resolvida pelo frontend com a própria origem.
  link      String?
  /// Dados adicionais estruturados (ex.: { workItemId, projectId }), mesmo padrão de
  /// `ItemActivity.metadata`.
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Preferências de canal de notificação, 1:1 com `User` — controla quais canais externos recebem
/// os disparos (a notificação em si, no sino, é sempre criada independente disto). Webhook é por
/// usuário: cada um cadastra sua própria URL (ex. automação pessoal em n8n/Zapier).
model NotificationPreference {
  userId          String   @id @map("user_id")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  telegramEnabled Boolean  @default(false) @map("telegram_enabled")
  webhookEnabled  Boolean  @default(false) @map("webhook_enabled")
  pushoverEnabled Boolean  @default(false) @map("pushover_enabled")
  googleChatEnabled Boolean @default(false) @map("google_chat_enabled")
  /// Chat id numérico do Telegram, obtido pelo próprio usuário conversando com o bot configurado
  /// em `/settings/telegram` e confirmado via botão "Testar" na tela de preferências.
  telegramChatId  String?  @map("telegram_chat_id")
  webhookUrl      String?  @map("webhook_url")
  /// User Key do Pushover, obtida pelo próprio usuário em sua conta Pushover e confirmada via
  /// botão "Testar" na tela de preferências.
  pushoverUserKey String?  @map("pushover_user_key")
  /// URL do webhook de entrada (incoming webhook) de um Space do Google Chat, criada pelo próprio
  /// usuário em "Apps e integrações > Webhooks" do Space — a URL já contém a chave/token de
  /// autenticação, então não há segredo adicional para gerar (diferente do webhook genérico).
  googleChatWebhookUrl String? @map("google_chat_webhook_url")
  /// Segredo usado para assinar o payload do webhook (HMAC-SHA256, header `X-Signature`) — gerado
  /// automaticamente na primeira vez que `webhookUrl` é definido, nunca escolhido pelo usuário nem
  /// devolvido em claro depois de gerado.
  webhookSecret   String?  @map("webhook_secret")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
