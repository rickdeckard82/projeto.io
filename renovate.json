{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "commitMessagePrefix": "deps:",
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencias"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 9am on monday"] },
  "vulnerabilityAlerts": {
    "labels": ["dependencias", "seguranca"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Agrupa patches/minors do backend num PR só",
      "matchFileNames": ["backend/package.json"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "backend (patch/minor)"
    },
    {
      "description": "Agrupa patches/minors do frontend num PR só",
      "matchFileNames": ["frontend/package.json"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "frontend (patch/minor)"
    },
    {
      "description": "prisma e @prisma/client sobem juntos e nunca sem revisão (ver AGENTS.md)",
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-pg"],
      "groupName": "prisma",
      "dependencyDashboardApproval": true
    }
  ]
}
